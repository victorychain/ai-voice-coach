{
  "name": "vocal-critic",
  "description": "AI-powered vocal performance analysis",
  "version": "1.0.0",
  "gpu": {
    "type": "A100-80GB",
    "count": 1
  },
  "container": {
    "image": "runpod/pytorch:2.1.0-py3.10-cuda12.1.0-devel-ubuntu22.04",
    "env": {
      "HF_HOME": "/workspace/cache"
    },
    "ports": [8000],
    "volumeMounts": [
      {
        "name": "workspace",
        "mountPath": "/workspace"
      }
    ]
  },
  "scaling": {
    "minWorkers": 0,
    "maxWorkers": 3,
    "idleTimeout": 300,
    "requestTimeout": 600
  },
  "healthCheck": {
    "endpoint": "/health",
    "interval": 30,
    "timeout": 10
  }
}

